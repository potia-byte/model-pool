    "gemini": {
      "displayName": "Gemini",
      "envKeys": ["GEMINI_API_KEY", "GOOGLE_API_KEY"],
      "baseUrl": "https://generativelanguage.googleapis.com/v1beta/openai",
      "stripPrefix": "models/",
      "defaultPricing": "free_tier",
      "trustListingPrice": false,
      "note": "Free tier covers Flash/Flash-Lite and Gemma; Pro models are metered so they are marked paid.",
      "exclude": [
        "tts",
        "image",
        "embedding",
        "veo",
        "lyria",
        "transcribe",
        "live",
        "aqa",
        "omni",
        "antigravity",
        "customtools",
        "nano-banana",
        "audio",
        "robotics",
        "computer-use"
      ],
      "rules": [
        {
          "match": "^gemini-.*pro",
          "coding": 3,
          "reasoning": 3,
          "pricing": "paid"
        },
        {
          "match": "^gemini-(?:[\\d.]+-)?flash-lite(?:-latest|-preview)?$",
          "coding": 2,
          "reasoning": 1,
          "toolCalling": true,
          "structuredOutput": true,
          "contextWindow": 1048576
        },
        {
          "match": "^gemini-(?:[\\d.]+-)?flash(?:-latest|-preview)?$",
          "coding": 2,
          "reasoning": 2,
          "toolCalling": true,
          "structuredOutput": true,
          "contextWindow": 1048576
        },
        {
          "match": "^gemma-",
          "coding": 1,
          "reasoning": 1,
          "toolCalling": false,
          "structuredOutput": false,
          "contextWindow": 131072
        }
      ],
      "validationModel": "gemini-flash-lite-latest",
      "effort": {
        "kind": "reasoning_effort",
        "models": "^gemini-(?:[\\d.]+-)?flash"
      }
    },
