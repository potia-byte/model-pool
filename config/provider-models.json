    "openrouter": {
      "displayName": "OpenRouter",
      "envKeys": ["OPENROUTER_API_KEY"],
      "baseUrl": "https://openrouter.ai/api/v1",
      "defaultPricing": "unknown",
      "note": "Not one model: every zero-priced model in the live catalog is a separate pool member (free flag comes from the provider's own pricing, never from a name). The openrouter/free router is a low-tier member whose actual served model is recorded per call.",
      "exclude": ["content-safety", "lyria", "guard"],
      "freeFallback": {
        "coding": 1,
        "reasoning": 1
