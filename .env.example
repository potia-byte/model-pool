# Copy to .env and fill in your own keys. Never commit .env.
# Variable names come from config/provider-models.json ("envKeys").
# Every key is optional: a provider without a key is simply NOT_CONFIGURED.
# The first listed variable present for a provider is used.

GEMINI_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
SAMBANOVA_API_KEY=
NVIDIA_API_KEY=
COHERE_API_KEY=
HUGGINGFACE_API_KEY=
ZAI_API_KEY=
VERCEL_AI_GATEWAY_API_KEY=
# Cloudflare Workers AI: token, plus account id (looked up automatically when
# the token can see exactly one account).
CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=

# --- pool switches (all optional) ---
# MODEL_POOL=off                        # disable the pool (opened.enabled === false)
# MODEL_POOL_DISABLED=groq,mistral      # comma-separated provider ids to switch off
# MODEL_POOL_ENV_FILE=../secrets/pool.env   # credentials file kept elsewhere; read first
